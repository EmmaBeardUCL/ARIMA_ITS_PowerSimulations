its_power_simulator <- function(t, errormodel = list(order = c(0, 0, 0), ar = NULL, ma = NULL), period = 1, k,
                                b0 = 0, b1_step = 0,
                                b2_covariate = 0, b2_mean = 0, b2_sd = 1, b2_shift_after_k = 0,
                                noise_sd = 0, b3_trend = 0,
                                include_covariate = FALSE,
                                model_covariate = FALSE,
                                include_trend = FALSE,
                                trend_model_method = "none", # "none", "xreg", "differencing"
                                trend_type = "deterministic", # "deterministic" or "stochastic"
                                stochastic_trend_sd = 0.1, 
                                log_transform_outcome = FALSE,
                                seed = NULL, n.sims) {
  
  if (!is.numeric(k) || length(k) != 1 || k < 0 || k >= t) {
    stop("Parameter 'k' (number of pre-intervention time points) must be a single integer between 0 and t-1 (inclusive).")
  }
  if (k %% 1 != 0) {
    stop("Parameter 'k' must be an integer.")
  }
  
  if (include_covariate && b2_sd < 0) {
    stop("If 'include_covariate' is TRUE, 'b2_sd' must be a non-negative numeric value.")
  }
  
  if (trend_type == "stochastic" && stochastic_trend_sd < 0) {
    stop("If 'trend_type' is 'stochastic', 'stochastic_trend_sd' must be a non-negative numeric value.")
  }
  
  if (!is.null(seed)) {
    set.seed(seed)
  }
  
  signif <- rep(FALSE, n.sims)
  theta <- rep(NA, n.sims)
  pvalue <- rep(NA, n.sims)
  b2_estimates <- rep(NA, n.sims)
  time_coefficients <- rep(NA, n.sims)
  trend_effect_simulated <- rep(NA, n.sims) # To store the actual trend effect for stochastic trend
  
  last_fake_data <- NULL
  
  errors_occurred <- c()
  
  check_order_validity <- function(p, d, q) {
    if (p < 0 || d < 0 || q < 0) {
      stop("ARIMA order components (p, d, q) must be non-negative.")
    }
    return(TRUE)
  }
  
  generate_fake_data <- function(t, errormodel, k, b0, b1_step,
                                 include_covariate, b2_covariate, b2_mean, b2_sd, b2_shift_after_k,
                                 noise_sd, include_trend, b3_trend, trend_type, stochastic_trend_sd, log_transform_outcome) {
    
    check_order_validity(errormodel$order[1], errormodel$order[2], errormodel$order[3])
    
    x1 <- c(rep(0, k), rep(1, t - k))
    
    time_var_component <- rep(0, t)
    
    if (include_trend) {
      if (trend_type == "deterministic") {
        time_var_component <- 1:t 
      } else if (trend_type == "stochastic") {
        stochastic_innovations <- rnorm(t, sd = stochastic_trend_sd)
        time_var_component <- cumsum(stochastic_innovations)
      }
    }
    
    x2 <- rep(0, t)
    
    if (include_covariate) {
      confounder_base <- b2_mean + arima.sim(n = t, list(ar = 0.5), sd = b2_sd)
      x2 <- confounder_base
      if (b2_shift_after_k != 0) {
        x2[(k + 1):t] <- x2[(k + 1):t] + b2_shift_after_k
      }
    }
    
    arima_model_spec <- list(order = errormodel$order)
    if (!is.null(errormodel$ar) && any(!is.na(errormodel$ar)) && length(errormodel$ar) > 0) {
      arima_model_spec$ar <- errormodel$ar
    }
    if (!is.null(errormodel$ma) && any(!is.na(errormodel$ma)) && length(errormodel$ma) > 0) {
      arima_model_spec$ma <- errormodel$ma
    }
    
    if (all(errormodel$order == c(0,0,0)) && (is.null(errormodel$ar) || all(errormodel$ar == 0)) && (is.null(errormodel$ma) || all(errormodel$ma == 0))) {
      error <- rnorm(t, sd = noise_sd)
    } else {
      e_innov <- rnorm(t + t * 0.8, sd = noise_sd)
      error_full <- arima.sim(model = arima_model_spec, n = t + t * 0.8, innov = e_innov)
      error <- tail(error_full, t)
    }
    
    y_linear <- b0 + (b1_step * x1)
    
    if(include_covariate){
      y_linear <- y_linear + (b2_covariate * x2)
    }
    if(include_trend){
      if (trend_type == "deterministic") {
        y_linear <- y_linear + (b3_trend * time_var_component)
      } else if (trend_type == "stochastic") {
        y_linear <- y_linear + (b3_trend * time_var_component)
      }
    }
    y_linear <- y_linear + error
    
    if (log_transform_outcome) {
      y <- exp(y_linear)
    } else {
      y <- y_linear
    }
    
    data.frame(time = 1:t, x1 = x1, x2 = x2, y = y,
               baseline_val = b0,
               step_effect = b1_step * x1,
               covariate_effect = b2_covariate * x2,
               trend_effect = b3_trend * time_var_component, 
               error_term = error)
  }
  
  pb <- txtProgressBar(style = 3, min = 0, max = n.sims)
  
  for (v in 1:n.sims) {
    setTxtProgressBar(pb, v)
    
    fake.data.n <- generate_fake_data(t, errormodel, k, b0, b1_step,
                                      include_covariate, b2_covariate, b2_mean, b2_sd, b2_shift_after_k,
                                      noise_sd, include_trend, b3_trend, trend_type, stochastic_trend_sd, log_transform_outcome)
    
    if (v == n.sims) {
      last_fake_data <- fake.data.n
    }
    
    sim_order <- errormodel$order
    
    xreg_components <- list(iv = as.numeric(fake.data.n$x1))
    
    if (model_covariate) {
      xreg_components$covariate <- as.numeric(fake.data.n$x2)
    }
    
    # Modeling the trend in the ARIMA function
    if (include_trend) {
      if (trend_model_method == "xreg") {
        # If deterministic, we model a simple linear time component
        # If stochastic, we also model a linear time component, assuming it's an approximation
        xreg_components$time <- as.numeric(fake.data.n$time)
      } else if (trend_model_method == "differencing") {
        # Differencing handles both deterministic and stochastic trends that are integrated processes
        if (sim_order[2] == 0) { # Only apply differencing if not already specified
          sim_order[2] <- 1
        }
      }
    }
    
    
    xreg_matrix <- if (length(xreg_components) > 0) do.call(cbind, xreg_components) else NULL
    
    dv <- fake.data.n$y
    if (log_transform_outcome) {
      dv <- log(dv)
    }
    
    model1 <- tryCatch({
      arima(dv,
            order = sim_order,
            xreg = xreg_matrix,
            optim.control = list(maxit = 1000),
            include.mean = TRUE)
    }, error = function(e) {
      errors_occurred <<- c(errors_occurred, paste("Simulation", v, "error:", e$message))
      return(NULL)
    })
    
    if (!is.null(model1)) {
      coef_names <- names(model1$coef)
      coef_values <- model1$coef
      var_coef <- model1$var.coef
      
      if ("iv" %in% coef_names) {
        theta[v] <- coef_values["iv"]
        suppressWarnings(
          pval_iv <- (1 - pnorm(abs(coef_values["iv"] / sqrt(var_coef["iv", "iv"])))) * 2
        )
        pvalue[v] <- pval_iv
        signif[v] <- pvalue[v] < 0.05
      }
      
      if (model_covariate && "covariate" %in% coef_names) {
        b2_estimates[v] <- coef_values["covariate"]
      }
      
      if (include_trend && trend_model_method == "xreg" && "time" %in% coef_names) {
        time_coefficients[v] <- coef_values["time"]
      } else if (include_trend && trend_model_method == "differencing") {
        time_coefficients[v] <- NA # Trend is handled by differencing, no explicit coefficient
      } else {
        time_coefficients[v] <- NA
      }
      
      if (include_trend && trend_type == "stochastic") {
        # Store the magnitude of the actual stochastic trend for analysis if needed
        # This will be the value of the last point in the simulated trend, or max(abs(trend))
        trend_effect_simulated[v] <- fake.data.n$trend_effect[t] # or some other summary
      }
    }
  }
  
  close(pb)
  
  results <- list(
    power = mean(signif, na.rm = TRUE),
    beta_iv = mean(theta, na.rm = TRUE),
    beta_covariate = mean(b2_estimates, na.rm = TRUE),
    beta_time = mean(time_coefficients, na.rm = TRUE), # This will be NA if differencing
    pvalue = mean(pvalue, na.rm = TRUE),
    simulated_stochastic_trend_magnitude = mean(trend_effect_simulated, na.rm = TRUE), # Mean of the simulated trend magnitudes
    last_sim_data = last_fake_data,
    errors = errors_occurred
  )
  
  return(results)
}
