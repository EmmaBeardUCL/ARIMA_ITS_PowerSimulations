predict_power_ci <- function(beta1, t, sd_white_noise) {
  # Coefficients (Estimates from your beta regression output)
  intercept_est <- 2.8795596
  coef_t_est <- 0.0124113
  coef_log_beta1_est <- 4.1642627
  coef_sd_white_noise_est <- -2.8693135 
  
  # Standard Errors (from your beta regression output)
  intercept_se <- 0.1083626133
  coef_t_se <- 0.0002663662
  coef_log_beta1_se <- 0.0879856485
  coef_sd_white_noise_se <- 0.0730233896 
  
  # Critical z-value for 95% confidence interval
  z_crit <- 1.96 
  
  # Calculate 95% CI for each coefficient
  # Lower bound = Estimate - (z_crit * SE)
  # Upper bound = Estimate + (z_crit * SE)
  
  intercept_lower <- intercept_est - (z_crit * intercept_se)
  intercept_upper <- intercept_est + (z_crit * intercept_se)
  
  coef_t_lower <- coef_t_est - (z_crit * coef_t_se)
  coef_t_upper <- coef_t_est + (z_crit * coef_t_se)
  
  coef_log_beta1_lower <- coef_log_beta1_est - (z_crit * coef_log_beta1_se)
  coef_log_beta1_upper <- coef_log_beta1_est + (z_crit * coef_log_beta1_se)
  
  coef_sd_white_noise_lower <- coef_sd_white_noise_est - (z_crit * coef_sd_white_noise_se)
  coef_sd_white_noise_upper <- coef_sd_white_noise_est + (z_crit * coef_sd_white_noise_se)
  
  # Calculate the Linear Predictor (eta) bounds for Power
  # Power = 1 / (1 + exp(-eta)) is an increasing function of eta.
  # So, eta_lower gives power_lower, and eta_upper gives power_upper.
  
  # For eta_lower: Use lower CI for positive coefficients, upper CI for negative coefficients
  eta_lower <- intercept_lower + 
    (coef_t_lower * t) + 
    (coef_log_beta1_lower * log(beta1)) + 
    (coef_sd_white_noise_upper * sd_white_noise) # coef_sd_white_noise is negative, so upper CI makes eta smaller (less negative)
  
  # For eta_upper: Use upper CI for positive coefficients, lower CI for negative coefficients
  eta_upper <- intercept_upper + 
    (coef_t_upper * t) + 
    (coef_log_beta1_upper * log(beta1)) + 
    (coef_sd_white_noise_lower * sd_white_noise) # coef_sd_white_noise is negative, so lower CI makes eta larger (more negative)
  
  # Apply the inverse logit function to get Power bounds
  power_lower <- 1 / (1 + exp(-eta_lower))
  power_upper <- 1 / (1 + exp(-eta_upper))
  
  return(c(lower = power_lower, upper = power_upper))
}

# Example usage (using values: t=100, b1=2, SD=1)
beta1 <- 2            # Value for beta1 (effectsize)
t <- 100              # Value for t (timepoint)
sd_white_noise <- 1   # Value for SD of white noise (N)

predicted_power_range <- predict_power_ci(beta1, t, sd_white_noise)
print(predicted_power_range)
