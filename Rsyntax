# sim.power
# Simulates power for an Interrupted Time Series (ITS) design,
# optionally including a covariate and a linear time trend, with ARIMA errors.
#
# This function takes the following parameters:
# - t: Integer. The total number of time points in the series.
# - errormodel: List. Specifies the ARIMA error model. Must contain order = c(p, d, q).
#   Optionally contains ar (numeric vector of AR coefficients) and ma (numeric vector of MA coefficients).
#   If ar or ma are provided, they are used for arima.sim. Otherwise, arima.sim will generate
#   coefficients based on the order.
# - period: Integer. The frequency of the time series (e.g., 1 for annual, 12 for monthly).
#   Used for creating ts objects. Note: This function currently only supports
#   non-seasonal ARIMA models in arima fitting, so period primarily affects
#   the ts object creation.
# - k: Integer. The number of pre-intervention time points. The intervention
#   (step change) occurs starting at time point k + 1. Must be between 0 and t-1 inclusive.
# - b0: Numeric. The intercept of the true data-generating process.
# - b1_step: Numeric. The true effect size of the step intervention.
#
# - include_covariate: Logical. If TRUE, a stochastic, time-varying covariate (x2)
#   is simulated and included in the true data-generating process and subsequently in the fitted model.
# - b2_covariate: Numeric. The true main effect coefficient for the simulated covariate (x2).
#   Only considered if include_covariate is TRUE.
# - b2_mean: Numeric. The mean of the simulated covariate (x2).
#   Only considered if include_covariate is TRUE.
# - b2_sd: Numeric. The standard deviation of the simulated covariate (x2).
#   Only considered if include_covariate is TRUE.
# - b2_shift_after_k: Numeric. The amount the covariate (x2) shifts after the intervention point k.
#   Only considered if include_covariate is TRUE. Defaults to 0 (no shift).
#
# - include_time_trend: Logical. If TRUE, a linear time trend is simulated
#   and included in the true data-generating process and subsequently in the fitted model.
# - b3_trend: Numeric. The true coefficient for the linear time trend.
#   Only considered if include_time_trend is TRUE.
#
# - noise_sd: Numeric. The standard standard deviation of the innovations (white noise)
#   driving the ARIMA error process.
# - plot_data: Logical. If TRUE, plots each simulated time series with
#   intervention and covariate lines.
# - seed: Integer. Optional. A seed for reproducibility of the simulations.
# - n.sims: Integer. The number of simulations to run.
#
# This function returns a list containing:
# - power: The proportion of simulations where the intervention
#   coefficient was statistically statistically significant (p < 0.05).
# - beta_iv: The mean estimated coefficient for the intervention variable.
# - beta_covariate: The mean estimated coefficient for the covariate.
#   Returns NA if include_covariate was FALSE.
# - beta_time: The mean estimated coefficient for the time trend.
#   Returns NA if include_time_trend was FALSE.
# - pvalue: The mean p-value for the intervention coefficient.

sim.power <- function(t, errormodel = list(order = c(0, 0, 0), ar = 0, ma = 0), period = 0, k,
                      b0 = 0, b1_step = 0,
                      include_covariate = FALSE,
                      b2_covariate = 0, b2_mean = 0, b2_sd = 1, b2_shift_after_k = 0, 
                      include_time_trend = FALSE,
                      b3_trend = 0,
                      noise_sd = 0, plot_data = FALSE, seed = NULL, n.sims = 1000) {
  
  # Validate k parameter
  if (!is.numeric(k) || length(k) != 1 || k < 0 || k >= t) {
    stop("Parameter 'k' (number of pre-intervention time points) must be a single integer between 0 and t-1 (inclusive).")
  }
  if (k %% 1 != 0) { # Check if k is an integer
    stop("Parameter 'k' must be an integer.")
  }
  
  # Validate covariate parameters if include_covariate is TRUE
  if (include_covariate && (b2_sd <= 0 || !is.numeric(b2_sd))) { # b2_sd must be positive
    stop("If 'include_covariate' is TRUE, 'b2_sd' must be a positive numeric value.")
  }
  
  # Set seed for reproducibility if provided
  if (!is.null(seed)) {
    set.seed(seed)
  }
  
  # Initialize vectors to store simulation results
  signif <- rep(FALSE, n.sims)
  theta <- rep(NA, n.sims) # Stores intervention coefficient estimates
  pvalue <- rep(NA, n.sims) # Stores intervention p-values
  b2_estimates <- rep(NA, n.sims) # Stores covariate coefficient estimates
  time_coefficients <- rep(NA, n.sims) # Stores time trend coefficient estimates
  
  # --- Check ARIMA model parameters ---
  check_order_validity <- function(p, d, q) {
    if (p < 0 || d < 0 || q < 0) {
      stop("ARIMA order components (p, d, q) must be non-negative.")
    }
    if (p > 5 || q > 5) { # Constraint: p and q should not be excessively large
      warning("Large ARIMA order (p or q) might lead to convergence issues or slow simulations.")
    }
    return(TRUE)
  }
  
  # --- Generate Fake Data ---
  generate_fake_data <- function(t, errormodel, k, b0, b1_step,
                                 include_covariate, b2_covariate, b2_mean, b2_sd, b2_shift_after_k,
                                 noise_sd, include_time_trend, b3_trend) {
    
    # Validate ARIMA order
    check_order_validity(errormodel$order[1], errormodel$order[2], errormodel$order[3])
    
    x1 <- c(rep(0, k), rep(1, t - k)) # Intervention indicator (step change)
    
    # Initialize variables that might not be included
    time_var_component <- rep(0, t)
    x2 <- rep(0, t)
    
    # Generate time trend if included
    if (include_time_trend) {
      time_var_component <- 1:t # Time variable
    }
    
    # Only simulate x2 if requested
    if (include_covariate) {
      confounder_base <- b2_mean + arima.sim(n = t, list(ar = 0.5), sd = b2_sd)
      x2 <- confounder_base
      if (b2_shift_after_k != 0) {
        x2[(k + 1):t] <- x2[(k + 1):t] + b2_shift_after_k
      }
    }
    
    # Generate autocorrelated errors using arima.sim
    arima_model_spec <- list(order = errormodel$order)
    # Only add AR/MA coefficients if they are actually specified and non-zero
    if (!is.null(errormodel$ar) && any(errormodel$ar != 0)) {
      arima_model_spec$ar <- errormodel$ar
    }
    if (!is.null(errormodel$ma) && any(errormodel$ma != 0)) {
      arima_model_spec$ma <- errormodel$ma
    }
    
    if (all(errormodel$order == c(0,0,0)) &&
        (is.null(errormodel$ar) || all(errormodel$ar == 0)) &&
        (is.null(errormodel$ma) || all(errormodel$ma == 0))) {
      error <- rnorm(t, sd = noise_sd)
    } else {
      
      e_innov <- rnorm(t + t * 0.8, sd = noise_sd)
      error_full <- arima.sim(model = arima_model_spec, n = t + t * 0.8, innov = e_innov)
      error <- tail(error_full, t)
    }
    
    # Generate the output series (dependent variable)
    y <- b0 + (b1_step * x1) +
      (b2_covariate * x2) +
      (b3_trend * time_var_component) + error
    
    # Always include 'time' for plotting/reference
    data.frame(time = 1:t, x1 = x1, x2 = x2, y = y)
  }
  
  # Set up a progress bar for user feedback
  pb <- txtProgressBar(style = 3, min = 0, max = n.sims)
  
  for (v in 1:n.sims) {
    setTxtProgressBar(pb, v) # Update progress bar
    
    # Generate fake data for the current simulation
    fake.data.n <- generate_fake_data(t, errormodel, k, b0, b1_step,
                                      include_covariate, b2_covariate, b2_mean, b2_sd, b2_shift_after_k,
                                      noise_sd, include_time_trend, b3_trend)
    
    # Extract order from the model specification
    order <- errormodel$order
    
    # Create time series objects
    dv <- ts(fake.data.n$y, frequency = period, start = c(1, 1))
    
    xreg_list <- list(iv = as.numeric(fake.data.n$x1))
    
    if (include_covariate) {
      xreg_list$covariate <- as.numeric(fake.data.n$x2)
    }
    
    if (include_time_trend) {
      xreg_list$time <- as.numeric(fake.data.n$time) 
    }
    
    xreg_matrix <- do.call(cbind, xreg_list)
    
    
    # Fit the ARIMAX model
    model1 <- tryCatch({
      arima(dv,
            order = c(order[1], order[2], order[3]), # ARIMA model order (non-seasonal)
            xreg = xreg_matrix, # Pass the dynamically created xreg_matrix
            optim.control = list(maxit = 1000), # Increase max iterations for convergence
            include.mean = TRUE)
    }, error = function(e) {
      warning(paste("ARIMA model fitting failed in simulation", v, ":", e$message))
      return(NULL) # Return NULL if fitting fails
    })
    
    # Proceed only if the model fits successfully
    if (!is.null(model1)) {
      # Extract and store the coefficients and p-values
      coef_names <- names(model1$coef)
      coef_values <- model1$coef
      var_coef <- model1$var.coef
      
      # Intervention coefficient (named 'iv' from xreg_matrix)
      if ("iv" %in% coef_names) {
        theta[v] <- coef_values["iv"]
        suppressWarnings(
          pval_iv <- (1 - pnorm(abs(coef_values["iv"] / sqrt(var_coef["iv", "iv"])))) * 2
        )
        pvalue[v] <- pval_iv
        signif[v] <- pvalue[v] < 0.05
      } else {
        warning(paste("Intervention coefficient 'iv' not found in model in simulation", v))
      }
      
      # Covariate coefficient
      if (include_covariate && "covariate" %in% coef_names) {
        b2_estimates[v] <- coef_values["covariate"]
      } else if (include_covariate && !("covariate" %in% coef_names)) {
        warning(paste("Covariate coefficient not found in model in simulation", v, "despite 'include_covariate' being TRUE."))
      }
      
      # Time trend coefficient
      if (include_time_trend && "time" %in% coef_names) {
        time_coefficients[v] <- coef_values["time"]
      } else if (include_time_trend && !("time" %in% coef_names)) {
        warning(paste("Time trend coefficient not found in model in simulation", v, "despite 'include_time_trend' being TRUE."))
      }
      
      # Plot data if plot_data is TRUE
      if (plot_data) {
        par(mar = c(7, 4, 4, 8), xpd = TRUE)
        
        plot(fake.data.n$time, fake.data.n$y, type = "l", col = "blue",
             xlab = "Time", ylab = "Value",
             main = paste("Simulation", v),
             ylim = range(c(fake.data.n$y, if(include_covariate) fake.data.n$x2 else NA), na.rm = TRUE)) # Adjust ylim to potentially include x2
        
        y_limits_plot <- par("usr")[3:4]
        
        segments(x0 = k + 0.5, y0 = y_limits_plot[1],
                 x1 = k + 0.5, y1 = y_limits_plot[2],
                 col = "red", lty = 2)
        
        legend_labels <- c("y (Dependent Variable)", "Intervention Point")
        legend_cols <- c("blue", "red")
        legend_ltys <- c(1, 2)
        
        if (include_covariate) {
          lines(fake.data.n$time, fake.data.n$x2, col = "green", lty = 3)
          legend_labels <- c(legend_labels, "Covariate (x2)")
          legend_cols <- c(legend_cols, "green")
          legend_ltys <- c(legend_ltys, 3)
        }
        
        # Add time trend line if included
        if (include_time_trend && b3_trend != 0) { # Only draw if there's a non-zero trend
          # Calculate the deterministic trend component for plotting
          trend_line_values <- b0 + b3_trend * (1:t)
          lines(1:t, trend_line_values, col = "purple", lty = 4)
          legend_labels <- c(legend_labels, "Time Trend (True)")
          legend_cols <- c(legend_cols, "purple")
          legend_ltys <- c(legend_ltys, 4)
        }
        
        legend("topright", inset = c(-0.3, 0),
               legend = legend_labels,
               col = legend_cols, lty = legend_ltys, cex = 0.7)
        
        Sys.sleep(0.5) # Pause briefly to view the plot
      }
    }
  }
  
  # Close the progress bar
  close(pb)
  
  # Summarize results
  results <- list(
    power = mean(signif, na.rm = TRUE),
    beta_iv = mean(theta, na.rm = TRUE),
    beta_covariate = if (include_covariate) mean(b2_estimates, na.rm = TRUE) else NA,
    beta_time = if (include_time_trend) mean(time_coefficients, na.rm = TRUE) else NA,
    pvalue = mean(pvalue, na.rm = TRUE)
  )
  
  print(results) # Print results to console
  return(results) # Return results as an R object
}
